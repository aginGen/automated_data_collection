    {
      "id": "87cea383-7ec1-417a-b33b-8b0850bc4602",
      "name": "Normalize fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ],
      "parameters": {
        "jsCode": "const norm=v=>String(v??'').normalize('NFKC').replace(/[\\u200B-\\u200D\\uFEFF]/g,'').replace(/\\s+/g,' ').trim();\nreturn $input.all().map(({json:r})=>{\n const text=norm(r.text_raw),author=norm(r.author_raw),stamp=Date.parse(r.collected_at_raw??r._collected_at);\n const errors=[];\n if(text.length<8||text.length>2000) errors.push('text: длина вне диапазона');\n if(author.length<2) errors.push('author: пустое или короткое имя');\n if(!Number.isFinite(stamp)) errors.push('collected_at: неверная дата');\n const tags=(Array.isArray(r.tags_raw)?r.tags_raw:[]).map(t=>norm(t).toLowerCase());\n if(tags.some(t=>! /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(t))) errors.push('tags: неверный slug');\n return {json:{text,author,tags:JSON.stringify(tags),source:r._source,\n  source_url:norm(r._source_url),source_record_id:norm(r.source_id_raw),\n  collected_at:Number.isFinite(stamp)?new Date(stamp).toISOString():'',\n  hash_input:author.toLowerCase()+'|'+text.toLowerCase().replace(/^[“”\"]+|[“”\"]+$/g,''),\n  valid:errors.length===0,reason:errors.join('; ')}};\n});"
      }
    },
    {
      "id": "881d38f1-646f-4028-90ba-2f2cbd367810",
      "name": "Business key",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        1150,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.hash_input }}",
        "dataPropertyName": "business_key",
        "encoding": "hex"
      }
    },
    {
      "id": "b9f9d6af-a56b-429d-bd3e-76f6eb9c7b73",
      "name": "Valid record",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
