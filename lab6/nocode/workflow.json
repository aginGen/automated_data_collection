      "name": "Select output fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        -100
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({json:r})=>{\n const {hash_input,valid,reason,...row}=r;return {json:row};\n});"
