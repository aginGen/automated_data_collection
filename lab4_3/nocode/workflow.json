    {
      "id": "962683b0-e10f-4bca-99ff-d6e6a977d75e",
      "name": "Normalize and deduplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n const r = item.json;\n const url = String(r.url).trim().replace(/\\/$/, '');\n const id = url.split('/').pop();\n const price = Number(String(r.price).replace(/[$,]/g, '').trim());\n if (!r.name || !id || !Number.isFinite(price) || price <= 0) throw new Error('Missing required field');\n if (!seen.has(id)) {\n  seen.add(id);\n  out.push({json:{snapshot_id:1,product_id:id,name:String(r.name).trim().replace(/\\s+/g, ' '),price:price.toFixed(2),currency:'USD',url,observed_at:new Date().toISOString()}});\n }\n if (out.length === 200) break;\n}\nif (out.length < 20) throw new Error('Fewer than 20 records');\nconst expected = $('Render JS').first().json.metrics.rows;\nif (out.length !== expected) throw new Error('Rendered and extracted catalogue sizes differ');\nreturn out;"
      }
    },
