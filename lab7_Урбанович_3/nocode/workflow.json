{
  "name": "Lab 7: Books to Scrape with error notification",
  "nodes": [
    {
      "id": "9d9abe84-8374-4488-bfe5-c8cfbe83e5ff",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -900,
        0
      ],
      "parameters": {}
    },
    {
      "id": "30d458b8-331c-4ab9-84b0-045f729dbc27",
      "name": "Daily schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "39a5278d-c801-4d72-a155-d5f0d59be388",
      "name": "Fetch books",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "url": "=https://books.toscrape.com/catalogue/page-{{ $json.offsets }}.html",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "text",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "onError": "continueErrorOutput"
    },
    {
      "id": "e172b8ac-8c60-4efc-a523-dd7c9aa70bdc",
      "name": "Split records",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        220,
        -100
      ],
      "parameters": {
        "fieldToSplitOut": "titles",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "fe250490-a1fe-4df1-b7b7-c1247210e2e5",
      "name": "Transform fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        450,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0031e8a1-1715-4e3f-825a-403744be172e",
              "name": "title",
              "value": "={{ $json.titles }}",
              "type": "string"
            },
            {
              "id": "2c4b760e-c0df-4df0-a1eb-5a8992c0664c",
              "name": "source",
              "value": "books.toscrape.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4080e018-fe1f-4f4e-863a-30ec188c57ee",
      "name": "CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        680,
        -100
      ],
      "parameters": {
        "operation": "csv",
        "options": {
          "fileName": "nocode_result.csv",
          "headerRow": true
        }
      }
    },
    {
      "id": "be71aeae-d53e-44c9-9ea8-80f20ea1c1fa",
      "name": "Save CSV",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        900,
        -100
      ],
      "parameters": {
        "operation": "write",
        "fileName": "../.lab-work/lab7_nocode_result.csv",
        "dataPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "75f1905d-ca0a-42a5-bdb5-bcefa77f71ca",
      "name": "Log HTTP error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        420
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "813fa2e8-4738-485e-a3bc-68f742a71048",
              "name": "message",
              "value": "={{ $json.error?.message || (\"HTTP status \" + ($json.statusCode ?? \"unknown\") + \"; or suspicious response\") }}",
              "type": "string"
            },
            {
              "id": "6219e34e-1d0a-4ad5-97e5-b7437dc2ec43",
              "name": "stage",
              "value": "HTTP request",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "e79baf5e-7ffd-4231-8a00-90a6e72cac8a",
      "name": "Error CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        930,
        420
      ],
      "parameters": {
        "operation": "csv",
        "options": {
          "fileName": "error_log.csv"
        }
      }
    },
    {
      "id": "acd24dcd-bfe5-4846-90dd-1b49684e9d64",
      "name": "Save error log",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1150,
        420
      ],
      "parameters": {
        "operation": "write",
        "fileName": "../.lab-work/lab7_error_log.csv",
        "dataPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "4019e4be-804d-4ee7-9a96-e574fe6b212a",
      "name": "Check books response",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ !Array.isArray($json.titles) || $json.titles.length < 20 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "07cda688-244a-4761-9d16-eee3289e9ff9",
      "name": "Pages",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -650,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bb3b4ef5-87f9-4975-b445-a2fbf49388ed",
              "name": "offsets",
              "type": "array",
              "value": "={{ [1, 2, 3] }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6074f6cf-869e-4570-8591-cd445560c855",
      "name": "Split pages",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -450,
        100
      ],
      "parameters": {
        "fieldToSplitOut": "offsets",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "5a5b4f37-0950-4d5f-a057-74126d0d32e0",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -250,
        100
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c3e40e72-0662-43d9-bae7-419fe85b6aa5",
      "name": "Wait 1 second",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      }
    },
    {
      "id": "7c6c1ad2-e15b-46d0-9865-17eaca02e13c",
      "name": "Extract titles",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        450,
        200
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "titles",
              "cssSelector": "article.product_pod h3 a",
              "returnValue": "attribute",
              "attribute": "title",
              "returnArray": true
            }
          ]
        },
        "options": {},
        "dataPropertyName": "data"
      }
    },
    {
      "id": "2ce405b9-8c22-4f3c-8686-34477bd66b49",
      "name": "HTTP status is 200",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        410,
        350
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "794b5782-d675-4afe-8466-264301a7118b",
      "name": "Stop with error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1380,
        420
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ $('Log HTTP error').first().json.message }}"
      }
    },
    {
      "id": "d4e052e5-0cc6-4f08-b0dd-0b446a02cdaf",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -650,
        850
      ],
      "parameters": {}
    },
    {
      "id": "402dece3-4d2d-4950-a08e-f9f129a59245",
      "name": "Format message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -150,
        850
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "247e5b4e-11ed-4959-a68e-70a4c0f8ba28",
              "name": "message",
              "type": "string",
              "value": "={{ ['Ошибка n8n: ' + ($json.workflow?.name || 'неизвестный workflow'), 'Узел: ' + ($json.execution?.lastNodeExecuted || $json.trigger?.error?.node?.name || 'неизвестен'), 'Причина: ' + ($json.execution?.error?.message || $json.trigger?.error?.message || 'нет подробностей'), 'Запуск: ' + ($json.execution?.url || 'недоступен')].join(String.fromCharCode(10)) }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "43d63c0b-5827-4201-8767-cb70a12d8377",
      "name": "Send Telegram message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        120,
        850
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Manual start": {
      "main": [
        [
          {
            "node": "Pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily schedule": {
      "main": [
        [
          {
            "node": "Pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pages": {
      "main": [
        [
          {
            "node": "Split pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split pages": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [
          {
            "node": "Split records",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 1 second",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 1 second": {
      "main": [
        [
          {
            "node": "Fetch books",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch books": {
      "main": [
        [
          {
            "node": "HTTP status is 200",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log HTTP error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check books response": {
      "main": [
        [
          {
            "node": "Log HTTP error",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split records": {
      "main": [
        [
          {
            "node": "Transform fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform fields": {
      "main": [
        [
          {
            "node": "CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CSV": {
      "main": [
        [
          {
            "node": "Save CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log HTTP error": {
      "main": [
        [
          {
            "node": "Error CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error CSV": {
      "main": [
        [
          {
            "node": "Save error log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract titles": {
      "main": [
        [
          {
            "node": "Check books response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP status is 200": {
      "main": [
        [
          {
            "node": "Extract titles",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log HTTP error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save error log": {
      "main": [
        [
          {
            "node": "Stop with error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Format message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format message": {
      "main": [
        [
          {
            "node": "Send Telegram message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Yekaterinburg",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
