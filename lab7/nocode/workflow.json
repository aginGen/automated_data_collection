{
  "name": "Lab 7 Resilient mixed collection",
  "nodes": [
    {
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "id": "fd5c1ea7-0c02-4b96-82b9-f4bb1a0b2ae5",
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "name": "Daily schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "id": "916aaac4-5377-476f-bfff-5be251afd2a2",
      "position": [
        0,
        180
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Prepare requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "fd147c47-5847-4da1-baf2-4bfab7902685",
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const state=$getWorkflowStaticData('global');\nstate.attempts={};\nreturn [1,2,3].map(page=>({json:{url:'http://127.0.0.2:8798/page/'+page,page}}));"
      }
    },
    {
      "name": "Loop requests",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "id": "ca7bbc37-15fa-4a61-9588-3be3b9f38c60",
      "position": [
        470,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "name": "Polite wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "id": "7a0ba807-441a-4727-8cb5-732708272fc0",
      "position": [
        700,
        100
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 0.6,
        "unit": "seconds"
      }
    },
    {
      "name": "Fetch page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "4bd73383-1cd2-44fd-9dd2-7325130c73ad",
      "position": [
        930,
        100
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "university-lab7-n8n/1.0"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "name": "Classify response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "ac722c37-1316-4290-9e34-7383ba84c2bf",
      "position": [
        1160,
        100
      ],
      "parameters": {
        "jsCode": "const request=$('Loop requests').item.json;\nconst state=$getWorkflowStaticData('global');\nconst url=request.url;\nconst attempt=(state.attempts[url]||0)+1;\nstate.attempts[url]=attempt;\nconst status=Number($json.statusCode);\nconst header=$json.headers?.['retry-after'];\nlet retry_after_s=1;\nif(header!==undefined){\n  const seconds=Number(header);\n  retry_after_s=Number.isFinite(seconds)?Math.max(0,seconds):Math.max(0,(Date.parse(header)-Date.now())/1000);\n  if(!Number.isFinite(retry_after_s)) retry_after_s=1;\n}\nreturn [{json:{url,attempt,status,body:$json.body,retry_after_s,\n retry:(status===429||status>=500&&status<=599)&&attempt<3,\n ok:status===200&&Array.isArray($json.body?.records)&&$json.body.records.length>=10}}];"
      }
    },
    {
      "name": "Retry temporary error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "id": "a6f905f6-0d4d-47c3-a36f-551389fba7d1",
      "position": [
        1390,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.retry }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Retry wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "id": "53804fcc-fe02-4e79-9ac5-27ba72b28dcd",
      "position": [
        1390,
        -170
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $json.retry_after_s }}",
        "unit": "seconds"
      }
    },
    {
      "name": "Check records",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "id": "090c4f80-8461-4d39-85cf-0318a88e7ce8",
      "position": [
        1630,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Split records",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "id": "a94ec41f-528a-4074-991d-27028a8c779c",
      "position": [
        1870,
        100
      ],
      "parameters": {
        "fieldToSplitOut": "body.records",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "name": "Normalize fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "21ad4014-1918-46b8-bb0e-ef475b874757",
      "position": [
        2100,
        100
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item=>({json:{\n business_key:String(item.json.key),\n title:String(item.json.title??'').normalize('NFKC').replace(/\\s+/g,' ').trim(),\n source:String(item.json.source),url:String(item.json.url)\n}}));"
      }
    },
    {
      "name": "Remove duplicates",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "id": "4a82ab08-c057-4868-b8c2-ea1f6ae2b559",
      "position": [
        700,
        -160
      ],
      "parameters": {
        "operation": "removeDuplicateInputItems",
        "compare": "selectedFields",
        "fieldsToCompare": "business_key",
        "options": {}
      }
    },
    {
      "name": "CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "id": "2095b6c5-ec2f-4f99-8fcd-00e9003091d1",
      "position": [
        930,
