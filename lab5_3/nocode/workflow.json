      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const q=$('Loop over quotes').item.json; const clean=s=>String(s ?? '').trim().replace(/\\s+/g,' '); const birth=clean($json.birth_date), place=clean($json.birth_place), bio=clean($json.biography); const m=birth.match(/^([A-Za-z]+)\\s+(\\d{1,2}),\\s+(\\d{4})$/); const months=['January','February','March','April','May','June','July','August','September','October','November','December']; if(!place || !bio || !m || !months.includes(m[1])) throw new Error('Missing author fields or invalid birth date'); const year=Number(m[3]), month=months.indexOf(m[1]), day=Number(m[2]); const d=new Date(Date.UTC(year,month,day)); if(year<100 || d.getUTCFullYear()!==year || d.getUTCMonth()!==month || d.getUTCDate()!==day) throw new Error('Invalid calendar date: '+birth); return {json:{...q,birth_date:birth,birth_place:place,biography:bio}};"
