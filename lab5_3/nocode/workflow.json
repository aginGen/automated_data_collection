    {
      "id": "26f675a9-7fd9-4671-ac56-441da406556e",
      "name": "Normalize fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto=require('crypto'); const clean=s=>String(s ?? '').trim().replace(/\\s+/g,' '); const q=$json; const m=q.birth_date.match(/^([A-Za-z]+)\\s+(\\d{1,2}),\\s+(\\d{4})$/); const months=['January','February','March','April','May','June','July','August','September','October','November','December']; if(!m || !months.includes(m[1])) throw new Error('Invalid birth date'); const y=Number(m[3]), mo=months.indexOf(m[1]), d=Number(m[2]), date=new Date(Date.UTC(y,mo,d)); if(y<100 || date.getUTCFullYear()!==y || date.getUTCMonth()!==mo || date.getUTCDate()!==d) throw new Error('Invalid calendar date'); return {json:{quote:q.quote,author:q.author,tags:JSON.stringify(q.tags.map(t=>clean(t).toLowerCase())),author_url:q.author_url,born_date:date.toISOString().slice(0,10),born_location:q.birth_place,biography:q.biography,source_url:q.source_url,list_page:Number(q.list_page),collected_at:new Date().toISOString(),business_key:crypto.createHash('sha256').update(q.author_key+'\\n'+q.quote,'utf8').digest('hex')}};"
      },
      "onError": "continueErrorOutput"
    },
