    {
      "id": "c91cb905-548a-48e0-93fd-e9e21d9f1f9f",
      "name": "Prepare quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        570,
        0
      ],
      "parameters": {
        "jsCode": "const clean=s=>String(s ?? '').trim().replace(/\\s+/g,' ');\nreturn $input.all().map((item,index)=>{ const q=item.json; const next=$('Split cards').all()[index].json.next; const m=String(next).match(/page\\/(\\d+)/); const quote=clean(q.quote), author=clean(q.author), path=String(q.author_path ?? '').trim();\nif(!m || !quote || !author || !/^\\/author\\/[A-Za-z0-9-]+\\/?$/.test(path) || !Array.isArray(q.tags) || q.tags.some(t=>!clean(t))) throw new Error('Missing or invalid quote, author, tags, author path, or pagination link');\nconst page=Number(m[1])-1;if(page<1 || page>3) throw new Error('Unexpected list page'); return {json:{quote,author,author_key:author.toLowerCase(),author_url:'https://quotes.toscrape.com'+path+(path.endsWith('/')?'':'/'),tags:q.tags,source_url:`https://quotes.toscrape.com/page/${page}/`,list_page:page},pairedItem:{item:index}}; });"
      },
      "onError": "continueErrorOutput"
    },
