    {
      "id": "3eacbe36-d640-467d-b1c9-40556bd297b1",
      "name": "Fetch robots.txt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -680,
        -80
      ],
      "parameters": {
        "url": "https://openlibrary.org/robots.txt",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "university-data-collection-n8n/1.0"
            }
          ]
        },
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "text",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "3054a6d0-1fb1-495a-b6d0-8b21bbc0e108",
      "name": "Check robots permission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        -80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst status = Number(r.statusCode);\nif (status === 404) return [{json: {robots_status: 404, robots_allowed: true}}];\nif (status !== 200 || typeof r.data !== 'string') {\n  throw new Error('robots.txt недоступен или вернул неподдерживаемый HTTP-статус; поиск остановлен');\n}\nconst text = r.data.replace(/^\\uFEFF/, '');\nif (!text.trim() || text.length > 512000 || /^\\s*<(?:!doctype|html)/i.test(text)) {\n  throw new Error('robots.txt пуст, слишком велик или похож на HTML; поиск остановлен');\n}\nconst groups = []; let group = null; let agentsSeen = 0;\nfor (const raw of text.split(/\\r?\\n/)) {\n  const line = raw.split('#', 1)[0].trim();\n  if (!line) continue;\n  const cut = line.indexOf(':');\n  if (cut < 0) throw new Error('Некорректный robots.txt; поиск остановлен');\n  const key = line.slice(0, cut).trim().toLowerCase();\n  const val = line.slice(cut + 1).trim();\n  if (key === 'user-agent') {\n    if (!val) throw new Error('Пустой User-agent в robots.txt; поиск остановлен');\n    if (!group || group.hasRules) { group = {agents: [], rules: [], hasRules: false}; groups.push(group); }\n    group.agents.push(val.toLowerCase()); agentsSeen++;\n  } else if (key === 'crawl-delay' || key === 'request-rate') {\n    if (!group || !group.agents.length) throw new Error('Ограничение без User-agent; поиск остановлен');\n    group.hasRules = true;\n    group.rules.push({limit: key});\n  } else if (key === 'allow' || key === 'disallow') {\n    if (!group || !group.agents.length) throw new Error('Правило без User-agent; поиск остановлен');\n    group.hasRules = true;\n    if (val) group.rules.push({allow: key === 'allow', pattern: val});\n  }\n}\nif (!agentsSeen) throw new Error('В robots.txt не найден User-agent; поиск остановлен');\nconst agent = 'university-data-collection-n8n';\nlet best = -1; let rules = [];\nfor (const g of groups) {\n  const lengths = g.agents.filter(a => a === '*' || agent.includes(a)).map(a => a === '*' ? 0 : a.length);\n  if (!lengths.length) continue;\n  const score = Math.max(...lengths);\n  if (score > best) { best = score; rules = [...g.rules]; }\n  else if (score === best) rules.push(...g.rules);\n}\nconst normalize = s => s.replace(/%[0-9a-f]{2}/gi, p => {\n  const ch = String.fromCharCode(parseInt(p.slice(1), 16));\n  return /^[A-Za-z0-9._~-]$/.test(ch) ? ch : p.toUpperCase();\n});\nconst target = '/search.json'; let selected = null;\nfor (const rule of rules) {\n  if (rule.limit) throw new Error('robots.txt содержит '+rule.limit+'; поиск остановлен для ручной настройки скорости');\n  const pattern = normalize(rule.pattern);\n  if (!rule.allow && pattern.includes('?')) {\n    throw new Error('В robots.txt есть запрет с параметрами запроса; поиск остановлен для ручной проверки');\n  }\n  const end = pattern.endsWith('$');\n  const body = end ? pattern.slice(0, -1) : pattern;\n  const escaped = body.split('*').map(s => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*');\n  const matches = new RegExp('^' + escaped + (end ? '$' : '')).test(target);\n  if (!matches) continue;\n  const length = body.replace(/\\*/g, '').length;\n  if (!selected || length > selected.length || (length === selected.length && rule.allow && !selected.allow)) selected = {allow: rule.allow, length};\n}\nif (selected && !selected.allow) throw new Error('robots.txt запрещает /search.json для данного User-Agent; поиск остановлен');\nreturn [{json: {robots_status: status, robots_allowed: true}}];"
      }
    }
  ],
