{
  "name": "Lab 3 Open Library REST API",
  "nodes": [
    {
      "id": "9d9abe84-8374-4488-bfe5-c8cfbe83e5ff",
      "name": "Manual start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -500,
        100
      ],
      "parameters": {}
    },
    {
      "id": "30d458b8-331c-4ab9-84b0-045f729dbc27",
      "name": "Daily schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -500,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "39a5278d-c801-4d72-a155-d5f0d59be388",
      "name": "Fetch books",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        100
      ],
      "parameters": {
        "url": "https://openlibrary.org/search.json",
        "options": {
          "timeout": 25000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "offset",
                    "value": "={{ $pageCount * 90 }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.docs.length === 0 || $pageCount * 90 >= $response.body.numFound }}",
              "limitPagesFetched": true,
              "maxRequests": 4,
              "requestInterval": 1100
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "university-data-collection-n8n/1.0"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "python programming"
            },
            {
              "name": "limit",
              "value": "90"
            },
            {
              "name": "offset",
              "value": "0"
            },
            {
              "name": "sort",
              "value": "key"
            },
            {
              "name": "fields",
              "value": "key,title,author_key,author_name,first_publish_year,language,edition_count"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1100,
      "onError": "continueErrorOutput",
      "alwaysOutputData": true
    },
    {
      "id": "e172b8ac-8c60-4efc-a523-dd7c9aa70bdc",
      "name": "Split records",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        50,
        100
      ],
      "parameters": {
        "fieldToSplitOut": "docs",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "fe250490-a1fe-4df1-b7b7-c1247210e2e5",
      "name": "Transform fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "4bbbcaa2-1483-4fa0-b751-3db17e5b71f3",
              "name": "work_id",
              "value": "={{ $json.key }}",
              "type": "string"
            },
            {
              "id": "4fd4b568-bd70-4499-bd0e-555dfec5e041",
              "name": "title",
              "value": "={{ String($json.title ?? '').trim().replace(/\\s+/g, ' ') }}",
              "type": "string"
            },
            {
              "id": "75eb8ab9-d87f-481e-9698-b312d4239646",
              "name": "first_publish_year",
              "value": "={{ $json.first_publish_year == null ? null : Number($json.first_publish_year) }}",
              "type": "number"
            },
            {
              "id": "9c60677e-4760-46e5-ad30-5826b44e0c15",
              "name": "edition_count",
              "value": "={{ Number($json.edition_count) }}",
              "type": "number"
            },
            {
              "id": "bfcd0113-bd32-478f-b9a4-e28d4c7a4bde",
              "name": "url",
              "value": "={{ 'https://openlibrary.org' + $json.key }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
